# Supabase project settings — Project Settings → API.
# Leave unset to run the app against the in-memory mock backend (see AUTH.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# There is deliberately no model API key here, and no endpoint to point at
# one. Ask answers are composed locally from the retrieved seed facts, so
# running or deploying this app cannot bill anyone. See the Ask section of
# the README.
