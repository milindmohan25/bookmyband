# Supabase project settings — Project Settings → API.
# Leave unset to run the app against the in-memory mock backend (see AUTH.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the ask feature sends questions. Leave unset and answers are
# composed locally from the retrieved seed facts instead of by a model.
# On Netlify: /.netlify/functions/ask
VITE_ASK_ENDPOINT=

# The model key. NOT a VITE_ variable, and deliberately so: anything
# prefixed VITE_ is inlined into the browser bundle. This belongs only in
# the server function's environment (Netlify -> Site settings ->
# Environment variables), never in the client and never in git.
#
# Set ONE of these. Groq wins if both are present.
#
# Groq (OpenAI-compatible):
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile     # optional, this is the default
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # optional
#
# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5          # optional, this is the default
#
# Do NOT try to reach Groq by setting ANTHROPIC_BASE_URL. That trick works
# for the Claude Code CLI, which translates between providers; the SDK in
# this project does not. It would POST an Anthropic-shaped body to
# /v1/messages against an endpoint serving OpenAI-shaped
# /chat/completions, and 404. Use GROQ_API_KEY instead.
