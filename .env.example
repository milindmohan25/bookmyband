# Supabase — new-style opaque keys (sb_publishable_... / sb_secret_...),
# read only on the server (supabase-public.server.ts). Never prefix
# these VITE_ — that would inline them into the browser bundle, and the
# whole point of the new key format is that they stay server-side.
# Leave both unset and the catalogue/booking server functions fall back
# to the same hand-authored seed set the demo has always run on.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The concierge's model key. Set ONE of these. Groq wins if both are
# present. Leave both unset and questions are answered by a
# deterministic local composer over the same retrieved facts, instead
# of by a model — the concierge stays honest about which happened.
#
# Groq (OpenAI-compatible):
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b         # optional, this is the default
#   Groq retires models often. If you get model_not_found, list yours with:
#     curl -s https://api.groq.com/openai/v1/models \
#       -H "Authorization: Bearer $GROQ_API_KEY" | grep -o '"id":"[^"]*"'
#   Pick an instruction-following model; avoid groq/compound* (web search).
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # optional
#
# Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5          # optional, this is the default
#
# Do NOT try to reach Groq by setting ANTHROPIC_BASE_URL. That trick works
# for the Claude Code CLI, which translates between providers; the SDK in
# this project does not.
