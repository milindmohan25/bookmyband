# Supabase project settings — Project Settings → API.
# Leave unset to run the app against the in-memory mock backend (see AUTH.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the ask feature sends questions. Leave unset and answers are
# composed locally from the retrieved seed facts instead of by a model.
# On Netlify: /.netlify/functions/ask
VITE_ASK_ENDPOINT=

# NOT a VITE_ variable, and deliberately so: anything prefixed VITE_ is
# inlined into the browser bundle. The Anthropic key belongs only in the
# server function's environment (Netlify -> Site settings -> Environment
# variables), never here.
# ANTHROPIC_API_KEY=
